<!-- The main window. Its named elements are typed attributes of main_window.py's
     MainWindow, which tools/xaml_types.py generates, and py:Event="handler" wires an
     event to a handler: XamlReader skips the py attributes (mc:Ignorable). Run it
     after renaming an element, changing its type, or changing a handler; layout
     changes need nothing. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" py:Closed="on_closed"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:py="https://pybricks.com/pybricks-voice/xaml" mc:Ignorable="py">
    <Grid Name="content" py:KeyDown="on_key">
        <Grid.Resources>
            <!-- The chat's bubbles: yours on the right in the accent color, the
                 robot's on the left. Each message says which it is. -->
            <Style x:Key="MineBubble" TargetType="Border">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="CornerRadius" Value="16,16,4,16"/>
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
            </Style>
            <Style x:Key="RobotBubble" TargetType="Border">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="CornerRadius" Value="16,16,16,4"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            </Style>
            <Style x:Key="MineText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
            </Style>
            <Style x:Key="RobotText" TargetType="TextBlock"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>
        <Grid Name="scene_area" py:PointerWheelChanged="on_wheel" Background="Transparent">
            <!-- Laid out at physical size and scaled down: see scene.py. -->
            <Canvas Name="host">
                <SwapChainPanel Name="panel"/>
            </Canvas>
            <Border Margin="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="8,4"
                    Background="#88000000" CornerRadius="4">
                <TextBlock Name="hud" py:Text="hud_line" Foreground="#c9d1dc" FontFamily="Consolas"/>
            </Border>
            <TextBlock Margin="12,10" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Foreground="#8a94a3" Text="C: camera · scroll: zoom"/>
        </Grid>
        <Grid Grid.Column="1" Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Talk to the robot" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock Name="status" py:Text="status_line" Opacity="0.7" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- Controls on top, their labels under them on one line. The switch's own
                 label would sit beside it, so it has none, and only the knob's width. -->
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ToggleSwitch Name="listen" py:Toggled="on_listen_toggled" OnContent="" OffContent="" IsOn="True" MinWidth="0" Width="40" Height="32"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <!-- The track is 1 px in WinUI's style: as thick as the bar here. -->
                <ProgressBar Name="level" py:Value="level_value" Grid.Column="1" MinHeight="10" CornerRadius="5" VerticalAlignment="Center"
                             Minimum="-70" Maximum="-10" Value="-70">
                    <ProgressBar.Resources>
                        <x:Double x:Key="ProgressBarTrackHeight">10</x:Double>
                    </ProgressBar.Resources>
                </ProgressBar>
                <TextBlock Name="listen_label" py:Text="listen_line" Grid.Row="1" Text="Listening" Opacity="0.6" FontSize="12"
                           HorizontalAlignment="Center"/>
                <TextBlock Name="level_text" py:Text="level_line" Grid.Row="1" Grid.Column="1" Opacity="0.6" FontFamily="Consolas"
                           FontSize="12" HorizontalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="typed" py:KeyDown="on_typed_key" PlaceholderText="…or type: forward 30 cm then turn left"/>
                <Button Name="go" py:Click="on_go" Grid.Column="1" Content="Go" Style="{StaticResource AccentButtonStyle}"/>
            </Grid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                <Button Name="stop" py:Click="on_stop" Content="Stop"/>
                <Button Name="reset" py:Click="on_reset" Content="Reset"/>
                <Button Name="camera" py:Click="on_camera" Content="Camera"/>
            </StackPanel>
            <ScrollViewer Name="scroller" Grid.Row="4" py:ViewChanged="on_chat_view_changed"
                          py:SizeChanged="on_chat_size_changed">
                <ItemsRepeater Name="log" py:ItemsSource="messages"
                               Margin="0,0,12,0">
                    <ItemsRepeater.Layout><StackLayout Spacing="8"/></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate py:Item="ChatItem">
                            <Border py:Style="bubble_style" MaxWidth="290" Padding="12,8,12,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Name="text" py:Text="text" py:Style="text_style" TextWrapping="Wrap"/>
                                    <TextBlock Name="detail" py:Text="detail" py:Style="text_style"
                                               py:Visibility="detail_visibility" FontSize="11" Opacity="0.75"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
            <!-- Three lines high however long the queue, so the chat above doesn't
                 jump as it changes. -->
            <TextBlock Name="queue_text" py:Text="queue_line" Grid.Row="5" Opacity="0.7" TextWrapping="Wrap" MaxLines="3"
                       TextTrimming="CharacterEllipsis" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                       Height="60"/>
        </Grid>
    </Grid>
    <!-- After the content: before it, an ItemsRepeater's ItemTemplate makes the
         app quit as the window shows, with no error (seen with XamlReader). -->
    <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
</Window>
